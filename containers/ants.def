Bootstrap: docker
# antsx/ants:v2.6.0, linux/amd64.
From: antsx/ants@sha256:dda7b4ffa3d32999304e1bb04a54b9928b6914b58c7c149802453a2d7d590a24
Stage: ants

Bootstrap: docker
From: python@sha256:a8e0a3090316aed0b11037aac613aef32fb1747dcc1dcb5c0f6c727a0113a07f
Stage: final

%files from ants
    /opt/ants /opt/ants

%files
    pyproject.toml /opt/brainhops-eval/pyproject.toml
    src /opt/brainhops-eval/src
    requirements /opt/brainhops-eval/requirements

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends libgomp1 libstdc++6 bc
    rm -rf /var/lib/apt/lists/*
    python -m pip install --no-cache-dir -r /opt/brainhops-eval/requirements/fixtures.txt SimpleITK==2.5.2
    python -m pip install --no-cache-dir --no-deps /opt/brainhops-eval
    python -m pip freeze > /opt/fixture-environment.txt

%environment
    export PATH=/opt/ants/bin:$PATH
    export LD_LIBRARY_PATH=/opt/ants/lib:${LD_LIBRARY_PATH:-}
    export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1
    export ANTS_RANDOM_SEED=1729
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1

%runscript
    exec brainhops-eval "$@"

%test
    /opt/ants/bin/antsRegistration --version
    python -c 'import SimpleITK'

