Bootstrap: docker
# python:3.11.11-slim-bookworm, linux/amd64 manifest (not a floating tag).
From: python@sha256:a8e0a3090316aed0b11037aac613aef32fb1747dcc1dcb5c0f6c727a0113a07f

%files
    pyproject.toml /opt/brainhops-eval/pyproject.toml
    src /opt/brainhops-eval/src
    requirements /opt/brainhops-eval/requirements
    software/_shared /opt/brainhops-eval/software/_shared
    software/simpleitk /opt/brainhops-eval/software/simpleitk

%post
    set -eu
    python -m pip install --no-cache-dir -r /opt/brainhops-eval/requirements/fixtures.txt -r /opt/brainhops-eval/software/simpleitk/requirements.txt
    python -m pip install --no-cache-dir --no-deps /opt/brainhops-eval
    python -m pip freeze > /opt/fixture-environment.txt

%environment
    export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1

%runscript
    cd /opt/brainhops-eval
    exec python -m software.simpleitk.generate "$@"

%test
    python -c 'import SimpleITK; assert SimpleITK.Version_VersionString() == "2.5.2"'
    cd /opt/brainhops-eval
    python -m software.simpleitk.generate --help

