Bootstrap: docker
From: python@sha256:a8e0a3090316aed0b11037aac613aef32fb1747dcc1dcb5c0f6c727a0113a07f

%files
    pyproject.toml /opt/brainhops-eval/pyproject.toml
    src /opt/brainhops-eval/src
    requirements /opt/brainhops-eval/requirements
    software/_shared /opt/brainhops-eval/software/_shared
    software/fsl /opt/brainhops-eval/software/fsl

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends libgomp1 libstdc++6 ca-certificates
    rm -rf /var/lib/apt/lists/*
    python /opt/brainhops-eval/software/fsl/extract_runtime.py /opt/fsl
    python -m pip install --no-cache-dir -r /opt/brainhops-eval/requirements/fixtures.txt
    python -m pip install --no-cache-dir --no-deps /opt/brainhops-eval
    python -m pip freeze > /opt/fixture-environment.txt

%environment
    export PATH=/opt/fsl/bin:$PATH
    export FSLDIR=/opt/fsl
    export LD_LIBRARY_PATH=/opt/fsl/lib:${LD_LIBRARY_PATH:-}
    export FSLOUTPUTTYPE=NIFTI_GZ
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1

%runscript
    cd /opt/brainhops-eval
    exec python -m software.fsl.generate "$@"

%test
    /opt/fsl/bin/flirt -version
    cd /opt/brainhops-eval
    python -m software.fsl.generate --help
